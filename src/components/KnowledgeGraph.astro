---
// Interactive force-directed knowledge graph of sectors ↔ sources.
// Self-contained so it can live on both the homepage and the /graph page.
//
// Only CONNECTED nodes are drawn. The earlier version plotted every source
// (250+) and the document types as nodes, but types had no edges at all and
// most sources lost theirs to the edge-weight cutoff — every disconnected
// node was then shoved by repulsion until it pinned against the canvas
// walls and corners as a halo of clipped dots. Document-type breakdowns
// live in the /landscape sector × type matrix instead.
import { getAllPolicies } from '../lib/data';

const policies = getAllPolicies();

const sectorMap = new Map<string, number>();
const sourceMap = new Map<string, number>();
const edges = new Map<string, number>();

for (const p of policies) {
  for (const s of p.sectors) sectorMap.set(s, (sectorMap.get(s) || 0) + 1);
  sourceMap.set(p.source_short, (sourceMap.get(p.source_short) || 0) + 1);
  for (let i = 0; i < p.sectors.length; i++) {
    for (let j = i + 1; j < p.sectors.length; j++) {
      const key = [p.sectors[i], p.sectors[j]].sort().join('|||');
      edges.set(key, (edges.get(key) || 0) + 1);
    }
    const ssKey = `${p.sectors[i]}|||${p.source_short}`;
    edges.set(ssKey, (edges.get(ssKey) || 0) + 1);
  }
}

const edgeList: { from: string; to: string; weight: number }[] = [];
for (const [key, weight] of edges) {
  if (weight < 3) continue;
  const [a, b] = key.split('|||');
  const fromId = sectorMap.has(a) ? `s:${a}` : `src:${a}`;
  const toId = sectorMap.has(b) ? `s:${b}` : `src:${b}`;
  edgeList.push({ from: fromId, to: toId, weight });
}
const keptEdges = edgeList.sort((a, b) => b.weight - a.weight).slice(0, 120);

// Nodes: only what survives in a kept edge — an unconnected node (tiny
// sector, low-volume source) just drifts to the canvas edge as noise.
const connected = new Set<string>();
for (const e of keptEdges) { connected.add(e.from); connected.add(e.to); }
const allNodes = [
  ...[...sectorMap].map(([name, count]) => ({ id: `s:${name}`, label: name, count, type: 'sector' })),
  ...[...sourceMap].map(([name, count]) => ({ id: `src:${name}`, label: name, count, type: 'source' })),
].filter(n => connected.has(n.id));

const graphData = JSON.stringify({ nodes: allNodes, edges: keptEdges });
---
<div class="graph-container" id="graph-container">
  <canvas id="graph-canvas"></canvas>
  <div class="graph-legend">
    <span class="legend-item"><span class="legend-dot" style="background:#16a34a;"></span>Sector</span>
    <span class="legend-item"><span class="legend-dot" style="background:#2563eb;"></span>Source</span>
  </div>
  <div class="graph-controls">
    <button class="btn btn-secondary btn-sm" id="graph-reset">Reset View</button>
    <label style="font-size:0.8rem; color:var(--color-text-muted); display:flex; align-items:center; gap:4px;">
      <input type="checkbox" id="graph-labels" checked /> Labels
    </label>
  </div>
  <p class="graph-caption">
    <strong>How to read this:</strong> green circles are the tracker's sectors,
    blue circles the sources that publish into them. A line means a source's
    documents land in that sector — thicker line, more documents; bigger
    circle, more documents overall. Hover any circle for its name and count;
    drag to rearrange. Sources with too few documents to link are not drawn.
  </p>
</div>

<style>
  .graph-container {
    position: relative;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-xl);
    box-shadow: var(--shadow-card);
  }
  #graph-canvas { width: 100%; height: 560px; cursor: grab; display: block; }
  #graph-canvas:active { cursor: grabbing; }
  .graph-legend {
    position: absolute; top: 12px; left: 12px;
    display: flex; gap: 12px;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 6px 12px;
    font-size: 0.72rem; font-weight: 600;
    color: var(--color-text-secondary);
    box-shadow: var(--shadow-sm);
  }
  .legend-item { display: flex; align-items: center; gap: 4px; }
  .legend-dot { width: 8px; height: 8px; border-radius: 50%; }
  .graph-controls {
    position: absolute; top: 12px; right: 12px;
    display: flex; gap: 8px; align-items: center;
  }
  .graph-caption {
    margin: 0;
    padding: 10px 14px;
    border-top: 1px solid var(--color-border-light);
    background: var(--color-bg-alt);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .graph-caption strong { color: var(--color-text-secondary); }
  @media (max-width: 768px) { #graph-canvas { height: 400px; } }
  @media (max-width: 480px) {
    #graph-canvas { height: 340px; }
    .graph-legend { position: static; margin: 8px; justify-content: center; box-shadow: none; border: none; }
    .graph-controls { position: static; margin: 4px 8px 8px; justify-content: center; }
    .graph-container { display: flex; flex-direction: column; }
  }
</style>

<script define:vars={{ graphData }}>
  function initKnowledgeGraph() {
    const data = JSON.parse(graphData);
    const canvas = document.getElementById('graph-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    if (!data.nodes || data.nodes.length === 0) {
      ctx.font = '16px sans-serif';
      ctx.fillStyle = '#888';
      ctx.textAlign = 'center';
      ctx.fillText('No policy data available yet.', canvas.getBoundingClientRect().width / 2, 200);
      return;
    }

    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.scale(dpr, dpr);
    const W = rect.width;
    const H = rect.height;

    const NODE_COLORS = { sector: '#16a34a', source: '#2563eb' };
    // Keep nodes clear of the container's rounded corners.
    const PAD = 18;

    // A phone canvas can't hold 90+ labelled nodes — it turns into overlapping
    // mush. On small screens keep only the busiest nodes and label just the top
    // handful; on desktop show them all.
    const mobile = W < 560;
    const MAX_NODES = mobile ? 34 : 999;
    const LABEL_TOP = mobile ? 10 : 26;
    const rMax = mobile ? 18 : 24;

    const picked = [...data.nodes].sort((a, b) => b.count - a.count).slice(0, MAX_NODES);
    const labelSet = new Set(picked.slice(0, LABEL_TOP).map(n => n.id));

    const nodes = picked.map((n, i) => {
      const angle = (i / picked.length) * Math.PI * 2;
      const radius = n.type === 'sector' ? W * 0.16 : n.type === 'source' ? W * 0.25 : W * 0.11;
      return {
        ...n,
        x: W / 2 + Math.cos(angle) * radius + (Math.random() - 0.5) * 40,
        y: H / 2 + Math.sin(angle) * radius + (Math.random() - 0.5) * 40,
        vx: 0, vy: 0,
        r: Math.max(4, Math.min(rMax, Math.sqrt(n.count) * (mobile ? 2.0 : 2.5))),
      };
    });

    const nodeMap = {};
    nodes.forEach(n => nodeMap[n.id] = n);
    const edges = data.edges.filter(e => nodeMap[e.from] && nodeMap[e.to]);

    let showLabels = true;
    let animFrame;
    let dragNode = null;
    let hoverNode = null;

    function nodeAt(mx, my, slack = 5) {
      for (const n of nodes) {
        const dx = mx - n.x, dy = my - n.y;
        if (dx * dx + dy * dy < (n.r + slack) * (n.r + slack)) return n;
      }
      return null;
    }

    function simulate() {
      for (let iter = 0; iter < 3; iter++) {
        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            let dx = nodes[j].x - nodes[i].x;
            let dy = nodes[j].y - nodes[i].y;
            let dist = Math.sqrt(dx * dx + dy * dy) || 1;
            let force = 800 / (dist * dist);
            let fx = (dx / dist) * force, fy = (dy / dist) * force;
            nodes[i].vx -= fx; nodes[i].vy -= fy;
            nodes[j].vx += fx; nodes[j].vy += fy;
          }
        }
        for (const e of edges) {
          const a = nodeMap[e.from], b = nodeMap[e.to];
          if (!a || !b) continue;
          let dx = b.x - a.x, dy = b.y - a.y;
          let dist = Math.sqrt(dx * dx + dy * dy) || 1;
          let force = (dist - 100) * 0.005 * Math.min(e.weight, 10);
          let fx = (dx / dist) * force, fy = (dy / dist) * force;
          a.vx += fx; a.vy += fy; b.vx -= fx; b.vy -= fy;
        }
        for (const n of nodes) {
          n.vx += (W / 2 - n.x) * 0.001;
          n.vy += (H / 2 - n.y) * 0.001;
        }
        for (const n of nodes) {
          n.vx *= 0.85; n.vy *= 0.85;
          n.x += n.vx; n.y += n.vy;
          n.x = Math.max(n.r + PAD, Math.min(W - n.r - PAD, n.x));
          n.y = Math.max(n.r + PAD, Math.min(H - n.r - PAD, n.y));
        }
      }
      // Keep the cloud centred (skip while dragging).
      if (!dragNode) {
        let cx = 0, cy = 0;
        for (const n of nodes) { cx += n.x; cy += n.y; }
        cx = cx / nodes.length - W / 2;
        cy = cy / nodes.length - H / 2;
        for (const n of nodes) { n.x -= cx; n.y -= cy; }
      }
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      for (const e of edges) {
        const a = nodeMap[e.from], b = nodeMap[e.to];
        if (!a || !b) continue;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y);
        ctx.strokeStyle = `rgba(150,150,150,${Math.min(0.4, e.weight * 0.02)})`;
        ctx.lineWidth = Math.max(0.5, Math.min(3, e.weight * 0.15));
        ctx.stroke();
      }
      for (const n of nodes) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fillStyle = NODE_COLORS[n.type] || '#888';
        ctx.globalAlpha = 0.85; ctx.fill(); ctx.globalAlpha = 1;
        ctx.strokeStyle = 'rgba(255,255,255,0.8)';
        ctx.lineWidth = 1.5; ctx.stroke();
        if (showLabels && labelSet.has(n.id)) {
          const fs = mobile ? 10 : Math.max(10, Math.min(13, n.r * 0.7));
          ctx.font = `600 ${fs}px 'Libre Franklin', sans-serif`;
          ctx.textAlign = 'center';
          const lx = Math.max(4 + ctx.measureText(n.label).width / 2,
                              Math.min(W - 4 - ctx.measureText(n.label).width / 2, n.x));
          // subtle halo so labels stay readable over nodes/edges
          ctx.lineWidth = 3;
          ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--color-bg-white') || '#fff';
          ctx.strokeText(n.label, lx, n.y + n.r + 12);
          ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--color-text') || '#1a1a18';
          ctx.fillText(n.label, lx, n.y + n.r + 12);
        }
      }

      // Hover tooltip: node name + document count, in a small pill that
      // stays inside the canvas.
      if (hoverNode && !dragNode) {
        const text = `${hoverNode.label} — ${hoverNode.count.toLocaleString()} documents`;
        ctx.font = `600 12px 'Libre Franklin', sans-serif`;
        const tw = ctx.measureText(text).width;
        const th = 24;
        let tx = Math.max(8, Math.min(W - tw - 24, hoverNode.x - tw / 2 - 8));
        let ty = hoverNode.y - hoverNode.r - th - 10;
        if (ty < 8) ty = hoverNode.y + hoverNode.r + 10;
        const bg = getComputedStyle(document.documentElement).getPropertyValue('--color-text') || '#1a1a18';
        const fg = getComputedStyle(document.documentElement).getPropertyValue('--color-bg-white') || '#fff';
        ctx.beginPath();
        if (ctx.roundRect) ctx.roundRect(tx, ty, tw + 16, th, 6);
        else ctx.rect(tx, ty, tw + 16, th);
        ctx.fillStyle = bg;
        ctx.globalAlpha = 0.92; ctx.fill(); ctx.globalAlpha = 1;
        ctx.fillStyle = fg;
        ctx.textAlign = 'left';
        ctx.fillText(text, tx + 8, ty + 16);
      }
    }

    let frame = 0;
    function animate() {
      simulate(); draw(); frame++;
      if (frame < 200) animFrame = requestAnimationFrame(animate);
    }
    animate();

    document.getElementById('graph-reset')?.addEventListener('click', () => {
      nodes.forEach((n, i) => {
        const angle = (i / nodes.length) * Math.PI * 2;
        const radius = n.type === 'sector' ? W * 0.16 : n.type === 'source' ? W * 0.25 : W * 0.11;
        n.x = W / 2 + Math.cos(angle) * radius;
        n.y = H / 2 + Math.sin(angle) * radius;
        n.vx = 0; n.vy = 0;
      });
      frame = 0; cancelAnimationFrame(animFrame); animate();
    });

    document.getElementById('graph-labels')?.addEventListener('change', (e) => {
      showLabels = e.target.checked; draw();
    });

    canvas.addEventListener('mousedown', (e) => {
      dragNode = nodeAt(e.offsetX, e.offsetY);
    });
    canvas.addEventListener('mousemove', (e) => {
      if (dragNode) {
        dragNode.x = e.offsetX; dragNode.y = e.offsetY;
        dragNode.vx = 0; dragNode.vy = 0; draw();
        return;
      }
      const over = nodeAt(e.offsetX, e.offsetY);
      canvas.style.cursor = over ? 'pointer' : 'grab';
      if (over !== hoverNode) { hoverNode = over; draw(); }
    });
    canvas.addEventListener('mouseup', () => { dragNode = null; });
    canvas.addEventListener('mouseleave', () => { dragNode = null; hoverNode = null; draw(); });

    canvas.addEventListener('touchstart', (e) => {
      const touch = e.touches[0];
      const rect = canvas.getBoundingClientRect();
      const mx = touch.clientX - rect.left, my = touch.clientY - rect.top;
      for (const n of nodes) {
        const dx = mx - n.x, dy = my - n.y;
        if (dx * dx + dy * dy < (n.r + 10) * (n.r + 10)) { dragNode = n; e.preventDefault(); break; }
      }
    });
    canvas.addEventListener('touchmove', (e) => {
      if (dragNode) {
        e.preventDefault();
        const touch = e.touches[0];
        const rect = canvas.getBoundingClientRect();
        dragNode.x = touch.clientX - rect.left;
        dragNode.y = touch.clientY - rect.top;
        dragNode.vx = 0; dragNode.vy = 0; draw();
      }
    });
    canvas.addEventListener('touchend', () => { dragNode = null; });
  }

  // Runs on first load AND after every ClientRouter navigation.
  document.addEventListener('astro:page-load', initKnowledgeGraph);
</script>
