---
import Base from '../layouts/Base.astro';
import { getPolicyItems, getEraDistribution, getMeta } from '../lib/data';

// Coverage stats are about policy, so they exclude news (level === 'media').
const policies = getPolicyItems();
const eras = getEraDistribution();
const meta = getMeta();

// Compute coverage stats. Undated items are excluded — an empty date string
// sorts before every real date, so counting them lumped ~74 items into
// "pre-2014" and produced a NaN year bucket, skewing the exact coverage-bias
// statistic this page exists to be honest about.
const dated = policies.filter(p => p.date);
const yearCounts: Record<number, number> = {};
for (const p of dated) {
  const y = parseInt(p.date.slice(0, 4));
  yearCounts[y] = (yearCounts[y] || 0) + 1;
}
const years = Object.keys(yearCounts).map(Number).sort();

const pre2014 = dated.filter(p => p.date < '2014-05-26').length;
const post2014 = dated.filter(p => p.date >= '2014-05-26').length;
const pre2014Pct = Math.round((pre2014 / dated.length) * 100);
const post2014Pct = Math.round((post2014 / dated.length) * 100);

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<Base title="About & Methodology" description="How PolicyDhara collects data, known coverage gaps, and limitations to be aware of when interpreting the data.">
  <div style="padding: var(--space-xl) 0; max-width: 780px;">
    <h2 class="page-title">About and methodology</h2>
    <p class="page-subtitle">How this data is collected, what it covers and what it leaves out.</p>

    {/* Important caveat — data bias */}
    <div class="caveat-box">
      <h3>Data coverage is uneven</h3>
      <p>
        PolicyDhara's dataset is an incomplete and unbalanced record of Indian policymaking.
        The number of policies shown for any government era depends on what our sources have available digitally,
        and it does not measure how much policy was made in that period.
      </p>
      <div class="caveat-stats">
        <div class="caveat-stat">
          <span class="caveat-num">{pre2014}</span>
          <span class="caveat-label">policies tracked pre-2014 ({pre2014Pct}%)</span>
        </div>
        <div class="caveat-stat">
          <span class="caveat-num">{post2014}</span>
          <span class="caveat-label">policies tracked 2014 onwards ({post2014Pct}%)</span>
        </div>
      </div>
      <p>
        This imbalance exists because most government digital portals (PIB, India Code, ministry websites) have much
        better archives for recent years. Older UPA-era and pre-UPA policies are underrepresented because
        fewer of them are available in machine-readable formats online.
      </p>
      <p>
        Higher counts in recent eras should not be read as evidence of more policy activity.
        India has always legislated actively, and the difference between eras comes from how much data is available digitally.
      </p>
    </div>

    {/* What is PolicyDhara */}
    <div class="about-section">
      <h3>What is PolicyDhara?</h3>
      <p>
        PolicyDhara is an open-source platform that tracks Indian development policies across sectors, states and time.
        It aggregates legislation, government schemes, budget announcements, notifications and policy research from official
        sources into a single searchable database.
      </p>
      <p>
        The name "Dhara" (meaning "flow" or "stream" in Hindi/Sanskrit) refers to the continuous flow of policy actions
        that shape India's development. PolicyDhara is a project of <a href="https://www.impactmojo.in">ImpactMojo</a>,
        which provides free development sector know-how.
      </p>
    </div>

    {/* Data sources */}
    <div class="about-section">
      <h3>Data sources</h3>
      <p>PolicyDhara collects from the following official and quasi-official sources:</p>
      <div class="source-list">
        <div class="source-item">
          <strong>Press Information Bureau (PIB)</strong>
          <span>Central government press releases and policy announcements</span>
        </div>
        <div class="source-item">
          <strong>India Code (Legislative Department)</strong>
          <span>Acts of Parliament and legislative texts</span>
        </div>
        <div class="source-item">
          <strong>PRS Legislative Research</strong>
          <span>Bill analyses, legislative briefs and parliamentary data</span>
        </div>
        <div class="source-item">
          <strong>NITI Aayog</strong>
          <span>Policy papers, reports and development research</span>
        </div>
        <div class="source-item">
          <strong>Reserve Bank of India (RBI)</strong>
          <span>Monetary policy, financial regulation and economic data</span>
        </div>
        <div class="source-item">
          <strong>Ministry of Finance / Budget Division</strong>
          <span>Union Budget documents and fiscal policy</span>
        </div>
        <div class="source-item">
          <strong>State PIB Offices</strong>
          <span>State-level policy announcements (coverage varies by state)</span>
        </div>
        <div class="source-item">
          <strong>Gazette of India / eGazette</strong>
          <span>Official notifications and statutory orders</span>
        </div>
      </div>
    </div>

    {/* Known biases */}
    <div class="about-section">
      <h3>Known biases and limitations</h3>
      <p>Keep the following in mind when interpreting this data:</p>
      <div class="bias-list">
        <div class="bias-item">
          <span class="bias-icon">1</span>
          <div>
            <strong>Recency bias in digital archives</strong>
            <p>Digital archives are far more complete for 2014-present than for earlier periods.
            Government websites frequently restructure, and older content is often lost or inaccessible.
            The PIB digital archive before ~2012 is particularly sparse. As a result, UPA-era policy counts
            are artificially low compared with NDA-era counts.</p>
          </div>
        </div>
        <div class="bias-item">
          <span class="bias-icon">2</span>
          <div>
            <strong>Central government overrepresentation</strong>
            <p>State-level policy coverage is limited to states with accessible digital portals.
            Many state governments publish in regional languages or in formats that are harder to aggregate.
            Central government actions are overrepresented relative to state actions.</p>
          </div>
        </div>
        <div class="bias-item">
          <span class="bias-icon">3</span>
          <div>
            <strong>Gap between announcement and implementation</strong>
            <p>Most entries capture policy announcements and official statements. Whether a policy was
            actually implemented, funded, or had its intended impact may differ a great deal from the announcement.
            Our impact annotations are best-effort estimates and are not formal evaluations.</p>
          </div>
        </div>
        <div class="bias-item">
          <span class="bias-icon">4</span>
          <div>
            <strong>Automated sector classification</strong>
            <p>Policies are classified into sectors using keyword matching. Some policies may be
            miscategorized or missing from relevant sectors. Cross-cutting policies (for example, Digital India affects
            multiple sectors) may not appear in all relevant categories.</p>
          </div>
        </div>
        <div class="bias-item">
          <span class="bias-icon">5</span>
          <div>
            <strong>English language bias</strong>
            <p>Most of the sources are in English. Policies published only in Hindi
            or regional languages may be underrepresented or missing entirely.</p>
          </div>
        </div>
        <div class="bias-item">
          <span class="bias-icon">6</span>
          <div>
            <strong>PIB as primary source</strong>
            <p>The Press Information Bureau (PIB) is the main channel for central government announcements. PIB releases tend to present government
            actions positively. Policies that were withdrawn, failed or were controversial may receive
            less coverage in PIB than successful initiatives.</p>
          </div>
        </div>
      </div>
    </div>

    {/* How data is collected */}
    <div class="about-section">
      <h3>Collection methodology</h3>
      <p>
        The database is updated every six hours from {meta.total_sources} sources: RSS feeds, JSON APIs and
        government web pages. Each item is classified by sector and type using keyword matching and
        deduplicated across sources.
      </p>
      <p>
        A handful of general-news feeds (The Hindu, NDTV and similar) are included for timely coverage. They carry
        crime, sport and celebrity items alongside policy. Items unrelated to policy are dropped, and media items
        are held to at most 40% of the dataset. News appears in the feed as context and is excluded from the
        aggregate numbers, so "policies tracked", sector trends and the activity timeline count policy items only.
      </p>
      <p>
        The fetch logic, the filter rules and the raw data are open on the
        <a href="https://github.com/Varnasr/PolicyDhara">GitHub repository</a>. The
        <a href="https://github.com/Varnasr/PolicyDhara/blob/master/ROADMAP.md">roadmap</a> lists what is planned next.
      </p>
    </div>

    {/* How to help */}
    <div class="about-section">
      <h3>Help improve coverage</h3>
      <p>
        Contributions are welcome if you notice missing policies or incorrect classifications, or if you have access to historical policy data,
        especially for UPA-era or pre-2004 policies:
      </p>
      <ul class="help-list">
        <li>Submit issues or pull requests on the GitHub repository</li>
        <li>Suggest new data sources, especially for state-level and historical policies</li>
        <li>Help digitise older policy documents that exist only in PDF or physical form</li>
        <li>Report misclassifications or incorrect dates</li>
      </ul>
    </div>

    {/* Subscribe + Open Source */}
    <div class="about-section">
      <h3>Subscribe and contribute</h3>
      <p>
        Get updates via the <a href={`${base}rss.xml`}>RSS feed</a>.
        Download data from the <a href={`${base}api/`}>API & Data Export</a> page.
        Contributions and bug reports are welcome on <a href="https://github.com/Varnasr/PolicyDhara">GitHub</a>.
      </p>
      <p>
        By <a href="https://www.impactmojo.in">ImpactMojo</a>, which provides free development sector know-how.
        This project is non-partisan and does not receive funding from any political party or government body.
      </p>
    </div>
  </div>
</Base>

<style>
  /* Caveat box */
  .caveat-box {
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
  }
  .caveat-box h3 {
    font-family: 'Fraunces', 'Newsreader', Georgia, serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }
  .caveat-box p {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-sm);
  }
  .caveat-box p:last-child { margin-bottom: 0; }
  .caveat-stats {
    display: flex;
    gap: 24px;
    margin: var(--space-md) 0;
  }
  .caveat-stat {
    display: flex;
    flex-direction: column;
  }
  .caveat-num {
    font-family: 'Fraunces', 'Newsreader', Georgia, serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .caveat-label {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  /* Sections */
  .about-section {
    margin-bottom: var(--space-xl);
  }
  .about-section h3 {
    font-family: 'Fraunces', 'Newsreader', Georgia, serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }
  .about-section p {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-sm);
  }
  .about-section a {
    color: var(--color-accent);
  }

  /* Source list */
  .source-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: var(--space-md);
  }
  .source-item {
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
  }
  .source-item strong {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-text);
  }
  .source-item span {
    font-size: 0.6875rem;
    color: var(--color-text-dim);
  }

  /* Bias list */
  .bias-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: var(--space-md);
  }
  .bias-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .bias-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-accent-fill);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .bias-item strong {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-text);
    margin-bottom: 2px;
  }
  .bias-item p {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 640px;
  }

  .help-list {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    padding-left: 20px;
  }

  @media (max-width: 768px) {
    .source-list { grid-template-columns: 1fr; }
    .caveat-stats { flex-direction: column; gap: 8px; }
  }
</style>
