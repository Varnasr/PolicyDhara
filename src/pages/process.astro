---
import Base from '../layouts/Base.astro';
import {
  getAllPolicies, getKind, getOpenDrafts, getBillItems, getQuestionReplies,
  getRecentCommitteeReports, getCommitteeReports, getParliamentData,
} from '../lib/data';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const all = getAllPolicies();
const byType = (t: string) => all.filter(p => p.type === t);
const byDateDesc = (a, b) => (b.date || '').localeCompare(a.date || '');

const drafts = getOpenDrafts(5);
const cabinet = all
  .filter(p => getKind(p) !== 'news' && /^(union )?cabinet (approves|clears|okays)/i.test(p.title))
  .sort(byDateDesc).slice(0, 5);
const bills = getBillItems(5);
const committeeReports = getRecentCommitteeReports(5);
const committeeTotal = getCommitteeReports().metadata.total_reports;
const acts = byType('act').sort(byDateDesc).slice(0, 5);
const rules = [...byType('rules'), ...byType('notification')].sort(byDateDesc).slice(0, 5);
const schemes = byType('scheme').sort(byDateDesc).slice(0, 5);
const questions = getQuestionReplies(5);
const parl = getParliamentData();

const fmtD = (d: string) => d ? new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '';

interface Stage {
  num: number;
  title: string;
  who: string;
  explain: string;
  items: { id?: string; title: string; meta: string; href: string }[];
  count: number;
  countLabel: string;
  browse: string;
  browseLabel: string;
}

const item = (p) => ({
  id: p.id,
  title: p.title,
  meta: `${p.source_short}${p.date ? ` · ${fmtD(p.date)}` : ''}${p.comment_deadline ? ` · comments close ${fmtD(p.comment_deadline)}` : ''}`,
  href: `${base}policies/${p.id}/`,
});

const stages: Stage[] = [
  {
    num: 1,
    title: 'Consultation: the draft',
    who: 'Ministries and regulators',
    explain: 'Many policies begin as a draft: a ministry publishes draft rules or a regulator floats a consultation paper, and the public is given a period, set by the ministry or regulator, to send comments and objections. Comments at this stage reach the authors before the text is final. Some policy starts elsewhere, in a Cabinet decision, a Budget announcement or a court order, and has no public draft.',
    items: drafts.map(item),
    count: byType('draft').length,
    countLabel: 'drafts on the tracker',
    browse: `${base}policies/?type=draft`,
    browseLabel: 'All drafts open for comment',
  },
  {
    num: 2,
    title: 'Cabinet approval',
    who: 'Union Cabinet',
    explain: 'Under the Government of India (Transaction of Business) Rules, 1961, cases involving legislation, including ordinances, must be brought before the Cabinet (Second Schedule, item (a)). Larger schemes also go to the Cabinet or a Cabinet committee, and smaller ones are approved at lower levels under the Department of Expenditure\'s appraisal rules. Cabinet decisions are announced through PIB releases.',
    items: cabinet.map(item),
    count: cabinet.length,
    countLabel: 'recent cabinet clearances',
    browse: `${base}policies/?kind=announcement&q=cabinet`,
    browseLabel: 'Search cabinet decisions',
  },
  {
    num: 3,
    title: 'The bill in Parliament',
    who: 'Lok Sabha & Rajya Sabha',
    explain: 'A bill may be introduced in either House of Parliament and is not passed unless both Houses agree to it, with or without amendments that both agree to (Article 107). Money Bills are the exception: they start only in the Lok Sabha, the Rajya Sabha can only send recommendations within 14 days, and the Lok Sabha may accept or reject them (Article 109). Bills can pass in days or wait for years. PRS Legislative Research found that 58% of the bills passed by the 17th Lok Sabha passed within two weeks of introduction, and that in the Monsoon Session of 2026 nine of the 11 bills passed by the Lok Sabha were passed without any member other than the Minister speaking on them.',
    items: bills.map(item),
    count: byType('bill').length,
    countLabel: 'bills tracked',
    browse: `${base}parliament/`,
    browseLabel: 'Parliament tracker',
  },
  {
    num: 4,
    title: 'Committee scrutiny',
    who: 'Standing & select committees',
    explain: 'Some bills are sent to parliamentary committees for detailed examination, which is the least visible part of Parliament\'s work. Referral is not compulsory. PRS counts 21% of the bills introduced in the 18th Lok Sabha up to the Monsoon Session of 2026 as referred to committees, against 16% in the 17th Lok Sabha and 28% in the 16th.',
    items: committeeReports.map(r => ({
      title: r.title,
      meta: `${r.committee_name}${r.presented_in_ls ? ` · ${fmtD(r.presented_in_ls)}` : ''}`,
      href: r.pdf_url || `${base}parliament/`,
    })),
    count: committeeTotal,
    countLabel: 'committee reports',
    browse: `${base}parliament/`,
    browseLabel: 'All committee reports',
  },
  {
    num: 5,
    title: 'Assent: the Act',
    who: 'President of India',
    explain: 'A bill passed by both Houses is presented to the President, who assents or withholds assent. If it is not a Money Bill, the President may return it with a message asking the Houses to reconsider it, and if they pass it again, with or without amendment, the President cannot withhold assent (Article 111). At any time other than when both Houses are in session, the President can also promulgate an ordinance if satisfied that circumstances require immediate action (Article 123(1)). An ordinance is laid before both Houses and ceases to operate six weeks after Parliament reassembles, or earlier if both Houses pass resolutions disapproving it (Article 123(2)(a)). Many Acts leave the detail to rules and bring sections into force by notification, so an Act can be law on paper before it operates.',
    items: acts.map(item),
    count: byType('act').length,
    countLabel: 'acts on the tracker',
    browse: `${base}policies/?type=act`,
    browseLabel: 'All acts',
  },
  {
    num: 6,
    title: 'Rules and notifications',
    who: 'Ministries, regulators, the Gazette',
    explain: 'Subordinate legislation is where much of an Act is worked out: rules fix the how, notifications bring sections into force, circulars instruct the machinery. These are made by the executive, and they usually do not need a separate vote on the floor of either House.',
    items: rules.map(item),
    count: byType('rules').length + byType('notification').length,
    countLabel: 'rules & notifications',
    browse: `${base}policies/?type=notification`,
    browseLabel: 'All notifications',
  },
  {
    num: 7,
    title: 'Schemes & implementation',
    who: 'Ministries, states, districts',
    explain: 'Policy reaches people as schemes: missions, yojanas and transfers. Implementation runs through states and districts, so the same scheme can look very different across the country.',
    items: schemes.map(item),
    count: byType('scheme').length,
    countLabel: 'schemes tracked',
    browse: `${base}policies/?type=scheme`,
    browseLabel: 'All schemes',
  },
  {
    num: 8,
    title: 'Oversight: Question Hour and audit',
    who: 'MPs, CAG, committees',
    explain: 'Scrutiny closes the loop. Ministers answer starred questions orally and unstarred questions in writing, so their replies are a source of implementation data, and audit reports test claims against what happened. Oral answers are a minority: in the Budget Session of 2025 ministers answered 28% of starred questions orally in the Lok Sabha (PRS).',
    items: questions.map(item),
    count: byType('question').length,
    countLabel: 'question-hour replies',
    browse: `${base}policies/?type=question`,
    browseLabel: 'All Q&A replies',
  },
];
---
<Base title="How Policy Is Made" description="The Indian policy lifecycle, from consultation draft to act, rules, schemes and parliamentary oversight, with live documents at every stage.">
  <div style="padding: var(--space-xl) 0;">
    <h1 class="page-title">How a policy is made</h1>
    <p class="page-subtitle">
      A policy goes through stages, and each stage leaves documents. This page walks
      the full lifecycle with the live documents currently sitting at every stage. For where the whole system comes from,
      start at the <a href={`${base}history/`}>Constituent Assembly debates</a>.
    </p>

    <div class="stage-list">
      {stages.map(s => (
        <section class="stage">
          <div class="stage-rail">
            <span class="stage-num">{s.num}</span>
            {s.num < stages.length && <span class="stage-line"></span>}
          </div>
          <div class="stage-body">
            <div class="stage-head">
              <h2 class="stage-title">{s.title}</h2>
              <span class="stage-who">{s.who}</span>
            </div>
            <p class="stage-explain">{s.explain}</p>
            <div class="stage-live">
              <div class="stage-live-head">
                <span class="stage-count">{s.count.toLocaleString()} {s.countLabel}</span>
                <a href={s.browse} class="stage-browse">{s.browseLabel} &rarr;</a>
              </div>
              {s.items.length === 0 ? (
                <p class="stage-empty">Nothing at this stage in the current fetch window.</p>
              ) : (
                <ul class="stage-items">
                  {s.items.map(it => (
                    <li>
                      <a href={it.href}>{it.title}</a>
                      <span class="stage-item-meta">{it.meta}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </section>
      ))}
    </div>

    <div class="process-foot">
      <p>
        Session dates, productivity and pending bills for the
        {parl.lok_sabha.current}th Lok Sabha are on the
        <a href={`${base}parliament/`}>Parliament tracker</a>. Fiscal choices
        behind every stage are on the <a href={`${base}budget/`}>Budget page</a>.
      </p>
    </div>
  </div>
</Base>

<style>
  .stage-list { margin-top: var(--space-xl); }
  .stage {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--space-md);
  }
  .stage-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .stage-num {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-bg-white);
    font-family: 'Fraunces', 'Newsreader', Georgia, serif;
    font-weight: 700;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .stage-line {
    flex: 1;
    width: 2px;
    background: var(--color-border);
    margin: 6px 0;
  }
  .stage-body { padding-bottom: var(--space-xl); min-width: 0; }
  .stage-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .stage-title {
    font-family: 'Fraunces', 'Newsreader', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 4px 0 0;
  }
  .stage-who {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }
  .stage-explain {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 68ch;
    margin: 6px 0 var(--space-sm);
  }
  .stage-live {
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 12px 16px;
    box-shadow: var(--shadow-sm);
  }
  .stage-live-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  .stage-count {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .stage-browse {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }
  .stage-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stage-items li {
    padding: 7px 0;
    border-top: 1px solid var(--color-border-light);
  }
  .stage-items a {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    line-height: 1.45;
  }
  .stage-items a:hover { color: var(--color-accent); }
  .stage-item-meta {
    display: block;
    font-size: 0.6875rem;
    color: var(--color-text-dim);
    margin-top: 1px;
  }
  .stage-empty {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 4px 0;
  }
  .process-foot {
    margin-top: var(--space-lg);
    padding: var(--space-md);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  @media (max-width: 600px) {
    .stage { grid-template-columns: 34px 1fr; }
    .stage-num { width: 28px; height: 28px; font-size: 0.875rem; }
  }
</style>
