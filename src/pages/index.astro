---
import Base from '../layouts/Base.astro';
import Insights from '../components/Insights.astro';
import PolicyCard from '../components/PolicyCard.astro';
import TrendingStrip from '../components/TrendingStrip.astro';
import NewsletterBar from '../components/NewsletterBar.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import {
  getAllPolicies, getMeta, getKind, getOpenDrafts, getBillItems,
  getQuestionReplies, getLongReads, TYPE_LABELS,
} from '../lib/data';

const allPolicies = getAllPolicies();
const meta = getMeta();
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const byDateDesc = (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime();

// Operational / non-policy chaff that shouldn't lead the feed even though it
// comes from official sources: auctions & tenders, HR notices, exam results,
// course/admission listings, and journal mastheads.
const LEAD_NOISE = /\b(workshop|webinar|auction|vrr|walk[- ]?in|recruitment|vacanc|result of the|tender|corrigendum|quiz|seniority list)\b|consumer (education|awareness|outreach)|(awareness|outreach) program|invites application|answer writing|\b(prelims|mains)\b|certificate (programme|program|course)|current affairs|admit card|\bresult\b\s*20\d\d|\bissue no\b|\bvol\.?\s*\d+/i;

// ── Kind-based streams ──────────────────────────────────────────────
// The taxonomy (see scripts/classifier.py) stamps every item with a kind:
// instrument (acts, rules, notifications, schemes…), process (bills, drafts,
// Parliament Q&A), announcement (press releases), analysis, news. The
// homepage leads with instruments and process — the reason the tracker
// exists — and presents news in its own clearly-labeled section instead of
// silently interleaving it with policy.
const instruments = allPolicies.filter(p => getKind(p) === 'instrument' && !LEAD_NOISE.test(p.title));
const processItems = allPolicies.filter(p => getKind(p) === 'process' && !LEAD_NOISE.test(p.title));
const newsItems = allPolicies.filter(p => getKind(p) === 'news');

// Diversify by source so one high-volume publisher can't fill a run of
// consecutive slots. Round-robin: each pass emits one item per source.
const diversifyBySource = (items: typeof allPolicies) => {
  const bySource = new Map<string, typeof allPolicies>();
  for (const p of items) {
    const q = bySource.get(p.source_id);
    if (q) q.push(p); else bySource.set(p.source_id, [p]);
  }
  for (const q of bySource.values()) q.sort(byDateDesc);
  const queues = [...bySource.values()];
  const result: typeof allPolicies = [];
  while (queues.some(q => q.length)) {
    queues.filter(q => q.length)
      .sort((a, b) => byDateDesc(a[0], b[0]))
      .forEach(q => result.push(q.shift()!));
  }
  return result;
};

// Lead story: a real policy instrument, rotating daily among the most recent.
const LEAD_POOL = 10;
const buildDay = Math.floor(Date.now() / 86400000);
const leadPool = [...instruments].filter(p => p.date).sort(byDateDesc).slice(0, LEAD_POOL);
const lead = leadPool.length ? leadPool[buildDay % leadPool.length] : allPolicies[0];
const notLead = (p) => !lead || p.id !== lead.id;

const recentDocs = diversifyBySource(
  [...instruments, ...processItems].filter(notLead)
).slice(0, 6);

// Policy in the making: drafts open for comment, bills before Parliament,
// and ministers' replies to starred/unstarred questions.
const drafts = getOpenDrafts(4);
const bills = getBillItems(4);
const questions = getQuestionReplies(4);

// Long reads and analysis.
const longReads = getLongReads(4);

// News — its own section, clearly labeled, headlines only.
const newsHeadlines = diversifyBySource(newsItems).slice(0, 8);

// Stats: count what actually matters, honestly.
const now = Date.now();
const DAY = 86400000;
const enactedThisWeek = instruments.filter(p => {
  if (!p.date) return false;
  const t = new Date(p.date).getTime();
  if (Number.isNaN(t)) return false;
  const age = now - t;
  return age >= 0 && age < 7 * DAY;
}).length;

const fmtDate = (d: string) => d ? new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : '';
---
<Base title="Dashboard">

  {/* ── Compact Hero ─────────────────────────────────── */}
  <div class="dash-hero">
    <div class="dash-hero-left">
      <h1 class="dash-title">PolicyDhara</h1>
      <p class="dash-subtitle">Tracking Indian development policy — from draft to gazette to ground</p>
      <p class="dash-intro">An open-source platform by <a href="https://www.impactmojo.in">ImpactMojo</a> that follows policy the way it is actually made: consultation drafts, bills in Parliament, question-hour replies, enacted instruments — with research and news kept clearly apart.</p>
      <a href="https://t.me/policydhara" class="hero-telegram-cta" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M22.05 2.79 2.34 10.4c-1.34.54-1.33 1.29-.24 1.62l5.06 1.58 11.71-7.39c.55-.34 1.06-.16.64.21l-9.48 8.56h-.01l.01.01-.35 5.22c.5 0 .72-.23.99-.5l2.39-2.33 4.97 3.67c.92.5 1.58.24 1.81-.85l3.27-15.42c.34-1.33-.51-1.94-1.36-1.6Z"/>
        </svg>
        <span class="hero-telegram-long">Follow <strong>@policydhara</strong> on Telegram for live alerts</span>
        <span class="hero-telegram-short">Follow <strong>@policydhara</strong> on Telegram</span>
        <span class="hero-telegram-arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <div class="dash-hero-stats">
      <div class="dash-stat">
        <span class="dash-stat-num">{instruments.length.toLocaleString()}</span>
        <span class="dash-stat-label">policy documents</span>
      </div>
      <div class="dash-stat-divider"></div>
      <div class="dash-stat">
        <span class="dash-stat-num">{processItems.length}</span>
        <span class="dash-stat-label">in the making</span>
      </div>
      <div class="dash-stat-divider"></div>
      <div class="dash-stat">
        <span class="dash-stat-num">{meta.total_sources}</span>
        <span class="dash-stat-label">sources</span>
      </div>
      <div class="dash-stat-divider"></div>
      <div class="dash-stat">
        <span class="dash-stat-num">{enactedThisWeek}</span>
        <span class="dash-stat-label">enacted this week</span>
      </div>
    </div>
  </div>

  {/* ── Trending ── */}
  <TrendingStrip />

  {/* ── Knowledge Graph feature (up top, full-width) ── */}
  <section class="home-graph-section">
    <div class="home-graph-head">
      <div>
        <h3>Policy Knowledge Graph</h3>
        <p>Which sources feed which sectors. Bigger circle = more documents; thicker line = stronger connection. Hover for counts, drag to explore.</p>
      </div>
      <a class="btn btn-secondary btn-sm" href={`${base}graph/`}>Full graph &amp; matrix &rarr;</a>
    </div>
    <KnowledgeGraph />
  </section>

  {/* ── Main Content: Two Column ── */}
  <div class="dash-grid">

    {/* ── Left: Lead Story + Recent ── */}
    <div class="dash-main">
      {lead && (
        <>
          {/* Lead story — always a genuine policy instrument */}
          <article class="lead-card" data-type={lead.type}>
            <div class="lead-accent"></div>
            <div class="lead-body">
              <div class="lead-meta">
                <span class={`policy-type type-${lead.type}`}>{TYPE_LABELS[lead.type] ?? lead.type}</span>
                <span class="lead-source">{lead.source_short}</span>
                <span class="lead-date">{new Date(lead.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
              </div>
              <h2 class="lead-title">
                <a href={`${base}policies/${lead.id}/`}>{lead.title}</a>
              </h2>
              {lead.description && (
                <p class="lead-desc">{lead.description}</p>
              )}
              <div class="policy-sectors">
                {lead.sectors.map(s => (
                  <a href={`${base}sectors/${s.toLowerCase().replace(/ & /g, '-').replace(/ /g, '-')}/`} class="sector-badge">{s}</a>
                ))}
              </div>
            </div>
          </article>

          {/* Latest instruments & process documents */}
          <div class="recent-grid">
            {recentDocs.map(p => (
              <PolicyCard id={p.id} title={p.title} description={p.description} link={p.link}
                date={p.date} source_short={p.source_short} sectors={p.sectors} type={p.type}
                kind={getKind(p)} source_id={p.source_id} authority={p.authority} />
            ))}
          </div>

          <div style="text-align:center; padding: var(--space-sm) 0 var(--space-lg);">
            <a class="btn btn-secondary" href={`${base}policies/`}>Browse all {allPolicies.filter(p => ['instrument', 'process'].includes(getKind(p))).length} policy documents &rarr;</a>
          </div>
        </>
      )}

      {/* ── How policy is made: drafts / bills / question hour ── */}
      <section class="making-section">
        <div class="section-header">
          <h3>Policy in the making</h3>
          <p>Before a policy is a policy it is a draft, a bill, a question on the floor of the House. Track it there.</p>
        </div>
        <div class="making-grid">
          <div class="making-col">
            <h4 class="making-col-title">Open for comment</h4>
            {drafts.length === 0 && <p class="making-empty">No open consultations detected right now.</p>}
            {drafts.map(p => (
              <a class="making-item" href={`${base}policies/${p.id}/`}>
                <span class="making-item-title">{p.title}</span>
                <span class="making-item-meta">{p.source_short}{p.date ? ` · ${fmtDate(p.date)}` : ''}</span>
              </a>
            ))}
          </div>
          <div class="making-col">
            <h4 class="making-col-title">Bills before Parliament</h4>
            {bills.length === 0 && <p class="making-empty">No tracked bills right now.</p>}
            {bills.map(p => (
              <a class="making-item" href={`${base}policies/${p.id}/`}>
                <span class="making-item-title">{p.title}</span>
                <span class="making-item-meta">{p.source_short}{p.date ? ` · ${fmtDate(p.date)}` : ''}</span>
              </a>
            ))}
            <a class="making-more" href={`${base}parliament/`}>Parliament tracker: sessions, bills, committees &rarr;</a>
          </div>
          <div class="making-col">
            <h4 class="making-col-title">Question Hour</h4>
            {questions.length === 0 && <p class="making-empty">Ministers' replies to starred and unstarred questions appear here as Parliament sits.</p>}
            {questions.map(p => (
              <a class="making-item" href={`${base}policies/${p.id}/`}>
                <span class="making-item-title">{p.title}</span>
                <span class="making-item-meta">{p.source_short}{p.date ? ` · ${fmtDate(p.date)}` : ''}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      {/* ── Long reads ── */}
      {longReads.length > 0 && (
        <section class="longread-section">
          <div class="section-header section-header-row">
            <div>
              <h3>Long reads</h3>
              <p>In-depth essays and analysis from EPW, The India Forum, Ideas for India, IDR and others.</p>
            </div>
            <a class="btn btn-secondary btn-sm" href={`${base}longform/`}>All long reads &rarr;</a>
          </div>
          <div class="longread-grid">
            {longReads.map(p => (
              <a class="longread-card" href={`${base}policies/${p.id}/`}>
                <span class="longread-source">{p.source_short}</span>
                <span class="longread-title">{p.title}</span>
                {p.description && <span class="longread-desc">{p.description.slice(0, 140)}{p.description.length > 140 ? '…' : ''}</span>}
              </a>
            ))}
          </div>
        </section>
      )}

      {/* ── News — clearly labeled, headlines only ── */}
      {newsHeadlines.length > 0 && (
        <section class="news-section">
          <div class="section-header section-header-row">
            <div>
              <h3>Policy in the news</h3>
              <p>Journalism about policy — context, not policy documents. Never counted in the tracker's policy numbers.</p>
            </div>
            <a class="btn btn-secondary btn-sm" href={`${base}policies/?kind=news`}>All coverage &rarr;</a>
          </div>
          <ul class="news-list">
            {newsHeadlines.map(p => (
              <li class="news-row">
                <a href={`${base}policies/${p.id}/`} class="news-link">{p.title}</a>
                <span class="news-meta">{p.source_short}{p.date ? ` · ${fmtDate(p.date)}` : ''}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* Analytics */}
      <div class="section-header">
        <h3>Activity</h3>
      </div>
      <Insights />
      <NewsletterBar />
    </div>

    {/* ── Right: Sidebar summary ── */}
    <aside class="dash-sidebar">
      <div class="sidebar-card">
        <h4 class="sidebar-card-title">By Sector</h4>
        <div class="sidebar-sector-list">
          {Object.entries(meta.sector_counts)
            .sort((a, b) => b[1] - a[1])
            .slice(0, 12)
            .map(([sector, count]) => (
              <a href={`${base}sectors/${sector.toLowerCase().replace(/ & /g, '-').replace(/ /g, '-')}/`} class="sidebar-sector-row">
                <span class="sidebar-sector-name">{sector}</span>
                <span class="sidebar-sector-count">{count}</span>
              </a>
            ))
          }
          <a href={`${base}sectors/`} class="sidebar-more">All sectors &rarr;</a>
        </div>
      </div>

      <div class="sidebar-card">
        <h4 class="sidebar-card-title">Quick Links</h4>
        <div class="sidebar-links">
          <a href={`${base}policies/`}>Browse Everything</a>
          <a href={`${base}parliament/`}>Parliament Tracker</a>
          <a href={`${base}budget/`}>Budget Analysis</a>
          <a href={`${base}longform/`}>Long Reads</a>
          <a href={`${base}history/`}>Policy History</a>
          <a href={`${base}digest/`}>Today's Digest</a>
          <a href={`${base}compare/`}>State Comparison</a>
          <a href={`${base}api/`}>API Access</a>
        </div>
      </div>

      <div class="sidebar-card sidebar-card-muted">
        <p class="sidebar-meta">
          Data from <strong>{meta.total_sources}</strong> government, media &amp; research sources.
          Updated every 6 hours. <a href={`${base}about/`}>Methodology</a>
        </p>
      </div>
    </aside>
  </div>

</Base>

<style>
  /* ── Home knowledge-graph feature ─────────────────── */
  .home-graph-section { margin: var(--space-2xl) 0; }
  .home-graph-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }
  .home-graph-head h3 {
    font-family: 'Fraunces', 'Newsreader', Georgia, serif;
    font-size: 1.4rem;
    margin: 0 0 4px;
  }
  .home-graph-head p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    max-width: 46ch;
  }
  @media (max-width: 600px) {
    .home-graph-head { flex-direction: column; align-items: stretch; }
  }

  /* ── Dashboard Hero ───────────────────────────────── */
  .dash-hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-bottom: 2px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }
  .dash-title {
    font-family: 'Fraunces', 'Newsreader', Georgia, serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .dash-subtitle {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: 4px;
  }
  .dash-intro {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-top: 8px;
    max-width: 520px;
  }
  .dash-intro a {
    color: var(--color-accent);
    font-weight: 600;
  }
  .hero-telegram-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding: 8px 14px;
    background: linear-gradient(135deg, #229ED9 0%, #2AABEE 100%);
    color: #fff;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(34, 158, 217, 0.25);
    transition: transform 0.15s, box-shadow 0.15s;
    max-width: 100%;
    flex-wrap: wrap;
    line-height: 1.3;
  }
  .hero-telegram-cta > span { min-width: 0; }
  .hero-telegram-cta:hover {
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(34, 158, 217, 0.35);
  }
  .hero-telegram-cta strong { font-weight: 700; }
  .hero-telegram-arrow {
    font-weight: 700;
    transition: transform 0.15s;
  }
  .hero-telegram-cta:hover .hero-telegram-arrow {
    transform: translateX(3px);
  }
  @media (max-width: 480px) {
    .hero-telegram-cta {
      font-size: 0.75rem;
      padding: 7px 12px;
      display: flex;
      width: 100%;
      justify-content: center;
    }
    .hero-telegram-long { display: none; }
  }
  @media (min-width: 481px) {
    .hero-telegram-short { display: none; }
  }
  .dash-hero-stats {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-shrink: 0;
  }
  .dash-stat {
    text-align: center;
  }
  .dash-stat-num {
    display: block;
    font-family: 'Fraunces', 'Newsreader', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }
  .dash-stat-label {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .dash-stat-divider {
    width: 1px;
    height: 32px;
    background: var(--color-border);
  }

  @media (max-width: 768px) {
    .dash-hero { flex-direction: column; align-items: flex-start; }
    .dash-hero-stats { gap: var(--space-lg); flex-wrap: wrap; }
    .dash-title { font-size: 1.5rem; }
  }
  @media (max-width: 480px) {
    /* 4 stats + 3 dividers don't fit on a phone — wrap, drop the dividers,
       and let each stat take its natural width with a sensible row gap. */
    .dash-hero-stats {
      flex-wrap: wrap;
      gap: var(--space-md) var(--space-lg);
      justify-content: flex-start;
      width: 100%;
    }
    .dash-stat-divider { display: none; }
    .dash-stat { text-align: left; flex: 0 0 auto; }
    .dash-stat-num { font-size: 1.25rem; }
    .dash-intro { font-size: 0.75rem; }
  }

  /* ── Two-column dashboard grid ─────────────────────── */
  .dash-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }
  @media (max-width: 960px) {
    .dash-grid { grid-template-columns: 1fr; }
  }

  /* ── Lead Card ─────────────────────────────────────── */
  .lead-card {
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-lg);
    transition: box-shadow 0.2s;
  }
  .lead-card:hover {
    box-shadow: var(--shadow-card-hover);
  }
  .lead-accent {
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent) 0%, var(--type-legislation) 50%, var(--type-announcement) 100%);
  }
  .lead-body {
    padding: 20px 24px;
  }
  .lead-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 0.75rem;
  }
  .lead-source {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-secondary);
    font-size: 0.6875rem;
  }
  .lead-date {
    color: var(--color-text-muted);
  }
  .lead-title {
    font-family: 'Fraunces', 'Newsreader', Georgia, serif;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text);
    margin-bottom: 8px;
  }
  .lead-title a { color: inherit; text-decoration: none; }
  .lead-title a:hover { color: var(--color-accent); }
  .lead-desc {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 12px;
    max-width: 700px;
  }

  @media (max-width: 600px) {
    .lead-body { padding: 16px; }
    .lead-title { font-size: 1.125rem; }
  }

  /* ── Recent Grid ───────────────────────────────────── */
  .recent-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: var(--space-md);
  }
  @media (max-width: 768px) {
    .recent-grid { grid-template-columns: 1fr; }
  }

  /* ── Policy in the making ──────────────────────────── */
  .making-section {
    margin: var(--space-lg) 0 var(--space-2xl);
    padding: var(--space-lg);
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .making-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }
  @media (max-width: 768px) {
    .making-grid { grid-template-columns: 1fr; }
  }
  .making-col-title {
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--type-notification);
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--type-notification-border);
  }
  .making-item {
    display: block;
    padding: 8px 0;
    border-bottom: 1px solid var(--color-border-light);
    text-decoration: none;
  }
  .making-item:last-of-type { border-bottom: none; }
  .making-item-title {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.45;
  }
  .making-item:hover .making-item-title { color: var(--color-accent); }
  .making-item-meta {
    display: block;
